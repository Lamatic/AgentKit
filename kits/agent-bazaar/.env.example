# Agent-Bazaar Kit — Environment Variables
# Copy this file to .env and fill in your values.

# Lamatic
LAMATIC_API_KEY=your-api-key
LAMATIC_PROJECT_ID=your-project-id
LAMATIC_API_URL=https://api.lamatic.ai/v1

# Flows (from Lamatic Studio → Flow Details)
FLOW_POST_BOUNTY=your-flow-id
FLOW_GENERATE_BID=your-flow-id
FLOW_EXECUTE_TASK=your-flow-id
FLOW_QA_JUDGE=your-flow-id
FLOW_UPDATE_REPUTATION=your-flow-id

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE=your-service-role-key
