# Lamatic
LAMATIC_API_KEY=your-lamatic-api-key
LAMATIC_PROJECT_ID=your-lamatic-project-id
LAMATIC_API_URL=https://your-project.lamatic.dev/graphql

# Flow IDs (5 flows)
FLOW_POST_BOUNTY=your-flow-id
FLOW_GENERATE_BID=your-flow-id
FLOW_EXECUTE_TASK=your-flow-id
FLOW_QA_JUDGE=your-flow-id
FLOW_UPDATE_REPUTATION=your-flow-id

# Supabase (browser client requires NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-side reads (supabase-server.ts) fall back to these when set
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Engine HTTP bridge (interactive dashboard)
ENGINE_URL=http://localhost:8787
# Dashboard caller credential for mutations (server-side only; never NEXT_PUBLIC_)
# Provision it as an x-dashboard-secret header or dashboard_secret cookie when set.
DASHBOARD_SECRET=
# Shared token for authenticated engine endpoints (server-side only, never NEXT_PUBLIC_)
ENGINE_TOKEN=
