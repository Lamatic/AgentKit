# Agent Bazaar engine — environment template
# Copy to engine/.env and fill in. Never commit the real .env.

# Supabase (service role — server only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# Lamatic
LAMATIC_API_KEY=
LAMATIC_PROJECT_ID=
LAMATIC_API_URL=https://<org>-<project>.lamatic.dev/graphql

# Flow IDs (5 flows)
FLOW_POST_BOUNTY=
FLOW_GENERATE_BID=
FLOW_EXECUTE_TASK=
FLOW_QA_JUDGE=
FLOW_UPDATE_REPUTATION=

# x402 (Base Sepolia testnet) — leave X402_PRIVATE_KEY empty to use the ledger adapter
X402_PRIVATE_KEY=
X402_FACILITATOR_URL=https://x402.org/facilitator

# Interactive HTTP bridge
ENGINE_PORT=8787
CRON_BUDGET_DAILY=200
