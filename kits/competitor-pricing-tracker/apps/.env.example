# Lamatic credentials — copy this file to .env.local and fill in real values.
# Get these from Lamatic Studio: Settings → API Keys / Project, and your flow's details panel.

LAMATIC_API_KEY=your-lamatic-api-key
LAMATIC_PROJECT_ID=your-lamatic-project-id
LAMATIC_API_URL=https://your-project.lamatic.dev

# The deployed Competitor Pricing Tracker flow ID (from the flow's details panel).
# This env key is declared by `envKey` in ../../lamatic.config.ts
COMPETITOR_PRICING_TRACKER_FLOW_ID=your-flow-id
