# Lamatic Central Configuration Keys
# Get these keys from Settings -> API Keys and Settings -> Project inside Lamatic Studio
LAMATIC_ENDPOINT=https://your-project.lamatic.ai/api/graphql
LAMATIC_PROJECT_ID=your-project-uuid
LAMATIC_API_KEY=your-api-key-here

# Deployed Lamatic Flow IDs
# Get these IDs from each deployed workflow's details panel or URL path
LAMATIC_SUSPECT_FLOW_ID=suspect-interrogation-flow-uuid
LAMATIC_EVIDENCE_FLOW_ID=evidence-examination-flow-uuid
LAMATIC_SOLUTION_FLOW_ID=solution-evaluation-flow-uuid

# Application Local Settings
# SQLite connection path (defaults to a local file in the backend folder)
DATABASE_URL=sqlite:///./detective_ai.db

# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:8000
