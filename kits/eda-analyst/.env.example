# EDA Analyst — environment variables
# The runnable app lives in apps/; copy apps/.env.example to apps/.env.local and fill it in.
# This root copy documents the same variables (bundles/kits ship a root .env.example).

# Your Lamatic GraphQL endpoint (Studio → Setup / API Docs)
LAMATIC_API_URL=https://your-org-your-project.lamatic.dev/graphql

# Your Lamatic project ID
LAMATIC_PROJECT_ID=your-project-id

# Your Lamatic API key (SECRET — never commit)
LAMATIC_API_KEY=your-lamatic-api-key

# The deployed EDA Analyst flow ID
EDA_ANALYST=your-eda-analyst-flow-id
