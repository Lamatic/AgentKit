# Lamatic project credentials — Lamatic Studio → Settings → API Keys
LAMATIC_API_KEY=your_lamatic_api_key_here
LAMATIC_PROJECT_ID=your_project_id_here
LAMATIC_API_URL=https://your-endpoint.lamatic.ai

# Deployed flow IDs — Lamatic Studio → Flow → Details Panel → Flow ID
LAMATIC_EVIDENCE_FIT_INDEX_FLOW_ID=your_index_flow_id_here
LAMATIC_EVIDENCE_FIT_EVALUATE_FLOW_ID=your_evaluate_flow_id_here
