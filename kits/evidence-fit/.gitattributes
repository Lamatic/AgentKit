# Built Lamatic code-node bodies are one line of minified JavaScript, and the string
# literals inside them are load-bearing. A checkout that rewrites LF to CRLF used to
# corrupt CLAUSE_TERMINATORS — a one-character Set member became the two-character
# "\r\n", so newline silently stopped terminating a clause and clause-aware chunking
# changed shape. build-node-body.cjs now escapes raw newlines, and this keeps the files
# themselves byte-stable on every platform. apps/__tests__/node-bodies.test.ts fails if
# either guard is lost.
scripts/*_code.ts text eol=lf

# The vendored engine copies must stay byte-identical to apps/lib/evidence/core.ts for
# apps/__tests__/vendor-parity.test.ts, which compares them as text.
scripts/*.ts text eol=lf
apps/lib/evidence/core.ts text eol=lf

# Studio exports are regenerated by the platform; keeping them LF makes re-export diffs
# show real graph changes instead of whole-file line-ending churn.
flows/*.ts text eol=lf
