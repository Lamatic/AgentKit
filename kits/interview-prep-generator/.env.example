# This template has no application/UI layer, so there's nothing to run
# locally from a .env file. These are the Lamatic project *secrets* the
# deployed flow expects - set them in Studio under Settings -> Secrets,
# not in a local .env.
#
# Both are optional: the flow works without them (Guardrail, resume
# verification, and generation all still run), it just skips live company
# research when company_name is provided but neither key is configured.

# Tavily API key, used by the Fact Lookup node. Get one at https://tavily.com
SEARCH_API_KEY=

# Browser Use Cloud API key, used by the Context Assembly node for live
# browsing research. Get one at https://cloud.browser-use.com/settings
BROWSER_USE_API_KEY=
