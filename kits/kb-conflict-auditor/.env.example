# Required: Lamatic Studio credentials and deployed flow ID
LAMATIC_API_URL="https://your-org.lamatic.dev/graphql"
LAMATIC_PROJECT_ID="your_lamatic_project_id"
LAMATIC_API_KEY="your_lamatic_api_key"
AUDIT_KB_FLOW_ID="your_audit_kb_flow_id"

# Optional: GitHub personal access token (raises API rate limit from 60 to 5,000 req/hr and allows private repos)
GITHUB_TOKEN=""
