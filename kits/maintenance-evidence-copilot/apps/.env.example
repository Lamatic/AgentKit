# Lamatic project credentials. Copy to .env.local and replace locally.
LAMATIC_API_KEY="your-lamatic-api-key"
LAMATIC_PROJECT_ID="your-lamatic-project-id"
LAMATIC_API_URL="https://your-project.lamatic.dev"

# Lamatic Studio → deployed triage-maintenance-event flow → Flow ID
TRIAGE_MAINTENANCE_EVENT_FLOW_ID="your-triage-maintenance-event-flow-id"
