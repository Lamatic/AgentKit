# Lamatic API credentials
LAMATIC_API_URL=https://api.lamatic.ai
LAMATIC_PROJECT_ID=your_lamatic_project_id
LAMATIC_API_KEY=your_lamatic_api_key

# Queryline Flow ID (set after deploying the flow in Lamatic Studio)
NL_TO_SQL_FLOW_ID=your_deployed_flow_id

# Session secret for iron-session
# REQUIRED. Must be a strong secret of at least 32 characters. No public
# fallback exists; the app fails closed if this is missing.
SESSION_PASSWORD=replace-with-a-32-character-minimum-secret

# Demo authentication configuration
# Disabled by default for security. Set DEMO_AUTH_ENABLED to "true" to
# explicitly opt in. Both DEMO_USERNAME and DEMO_PASSWORD must be configured
# when enabled. There is no fallback to demo/demo.
DEMO_AUTH_ENABLED=false
DEMO_USERNAME=your-demo-username
DEMO_PASSWORD=your-demo-password

# Demo sessions are restricted to the approved example questions (see
# lib/demo-questions.ts). Unsupported questions are blocked server-side and
# never reach the Lamatic flow or return fake data.

# Optional: return a canned response for local front-end testing without calling Lamatic.
# This is a development/testing mode only. Set to "false" (or omit) for the real public demo
# so approved questions execute the live NL-to-SQL flow.
# Restricted demo sessions never use mock output: approved questions always run the real flow.
MOCK_LAMATIC=false

# Optional: Azure SQL connection details for the flow's Microsoft SQL Server node
# These are typically configured in Lamatic Studio credentials.
MSSQL_SERVER=your_azure_sql_server.database.windows.net
MSSQL_PORT=1433
MSSQL_DATABASE=your_azure_sql_database
MSSQL_USER=your_azure_sql_user