# Orderly — environment template.
#
# Copy to .env.local and fill in real values. Never commit .env.local.
#
#   cp .env.example .env.local
#
# All five LAMATIC_* / *_FLOW_ID values come from Lamatic Studio
# (https://studio.lamatic.ai) after you have deployed the flow.

# ── Lamatic project credentials ──────────────────────────────────────────────
# Settings → API Docs → API → Endpoint
LAMATIC_API_URL=
# Settings → Project → Project ID
LAMATIC_PROJECT_ID=
# Settings → API Keys → Copy
LAMATIC_API_KEY=

# ── Flow IDs ─────────────────────────────────────────────────────────────────
# Open the deployed flow → details panel → Flow ID.
# Must match the `envKey` declared for each step in ../lamatic.config.ts.
MENU_SCAN_FLOW_ID=

# ── Image hosting (optional) ─────────────────────────────────────────────────
# The vision node fetches the menu photo over the public internet, so an
# uploaded file needs a public URL first. Get a token at
# https://vercel.com/dashboard/stores → Blob → Read/Write Token.
#
# Leave this blank to run without uploads: the app still accepts a pasted image
# URL, which is how the bundled demo menus work.
BLOB_READ_WRITE_TOKEN=
