# Lamatic Studio -> Settings -> API Keys
LAMATIC_API_KEY=
# Studio -> Settings -> Project -> Project ID
LAMATIC_PROJECT_ID=
# The "API URL" under the flow's API Docs -> Connect to your project, e.g. https://<org>-<project>.lamatic.dev
# (not the *.lamatic.workers.dev deployment host, which serves HTML)
LAMATIC_API_URL=
# The deployed send-gate flow (Studio -> flow -> Details panel). Leave empty to run the
# deterministic stages locally without any Lamatic call (the LLM judge is skipped).
SEND_GATE_FLOW_ID=
# Hosts truth_url may point at in local mode (https only; exact host or subdomain). The deployed
# Code node carries its own list (TRUTH_HOSTS in scripts/emit-code-node.mjs).
TRUTH_URL_HOSTS=raw.githubusercontent.com
# Optional bearer token sent to truth_url (the deployed flow reads the Studio project secret TRUTH_TOKEN instead).
# Never put tokens in the URL itself.
TRUTH_URL_TOKEN=
