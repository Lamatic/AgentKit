# SparkTrace — kit-level environment (deploy/Lamatic).
# The runnable Next.js app reads a superset of these — see apps/.env.example
# (which also covers AWS/Athena/Glue for live mode). Demo mode needs NONE of these.
# NEVER commit real values; copy to .env.local (gitignored) and fill in.

# --- Lamatic credentials (from Studio → Settings → API Keys / project) ---
LAMATIC_API_KEY=
LAMATIC_PROJECT_ID=
LAMATIC_API_URL=

# --- Deployed flow IDs (one per tiered agent) ---
SPARKTRACE_PLANNER_FLOW_ID=
SPARKTRACE_REPO_READER_FLOW_ID=
SPARKTRACE_QUERY_GEN_FLOW_ID=
SPARKTRACE_ANALYST_FLOW_ID=
SPARKTRACE_REPORTER_FLOW_ID=
