# SparkTrace infra — copy to `.env` and fill in. NEVER commit `.env`.
# These are the DEPLOYER credentials (used only to create/destroy the stack).
# The app itself gets a separate least-privilege read-only key (see README).

# --- Deployer AWS credentials (or use an AWS CLI profile instead) -----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Deployment settings (safe defaults; override only if you need to) -------
AWS_REGION=us-east-1
STACK_NAME=sparktrace-live
PROJECT_PREFIX=sparktrace

# Create a dedicated read-only IAM user for the app (recommended, free).
# Set to "false" if your deployer creds can't create IAM users.
CREATE_APP_USER=true

# Hard per-query Athena bytes-scanned cap. 10485760 = 10 MB = AWS minimum.
# This is the main "no surprise bills" guardrail — leave as-is.
BYTES_CUTOFF=10485760
