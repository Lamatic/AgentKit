# Lamatic credentials — Studio > Settings
LAMATIC_API_KEY=your_api_key_here
LAMATIC_PROJECT_ID=your_project_id_here
LAMATIC_API_URL=https://your-project.lamatic.dev/graphql

# Flow IDs — Studio > flow three-dot menu > Copy Flow Id
# Required by the app and `npm run gate`
LAMATIC_TERRAFORM_PLAN_REVIEW_FLOW_ID=your_flow_id_here
# Only needed for `npm run policies` (loading your own policy set)
LAMATIC_TERRAFORM_POLICY_INGEST_FLOW_ID=your_flow_id_here
